{
  "name": "agentshare-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b && npm run bundle:cli",
    "bundle:cli": "esbuild packages/cli/src/bin.ts --bundle --platform=node --format=esm --target=node22 --outfile=packages/cli/dist/bin.js",
    "clean": "tsc -b --clean",
    "dev:relay": "npm run dev --workspace @agentshare/relay",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc -b --pretty false && eslint .",
    "test": "vitest run",
    "test:edge-runtime": "node scripts/test-edge-runtime.mjs",
    "test:live:diagnostic": "node scripts/test-live-diagnostic.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:release": "node scripts/test-release.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "start:relay": "npm run start --workspace @agentshare/relay"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
