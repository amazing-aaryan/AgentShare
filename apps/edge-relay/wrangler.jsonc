{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agentshare-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARES",
        "class_name": "ShareObject",
      },
      {
        "name": "ENVIRONMENTS",
        "class_name": "EnvironmentObject",
      },
      {
        "name": "CONTROL",
        "class_name": "RelayControl",
      },
      {
        "name": "QUERIES",
        "class_name": "QueryObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShareObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RelayControl"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["QueryObject"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["EnvironmentObject"],
    },
  ],
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
